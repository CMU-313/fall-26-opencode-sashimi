            "output": "interface CreateTopicBody { title: string; cid: number }\n\nrouter.post('/topics', (req, res) => {\n  const body = req.body as CreateTopicBody\n  Topics.create(body.cid, body.title)\n  res.sendStatus(200)\n})",
